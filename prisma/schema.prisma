generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model batchproduk {
  id_batch            Int              @id @default(autoincrement())
  id_produk           Int
  id_pembelian        Int
  expired_date        DateTime
  qty_masuk           Int
  qty_sisa            Int
  created_at          DateTime         @default(now())
  id_pembelian_detail Int?
  no_batch            String?          @db.VarChar(100)
  pembelian           pembelian        @relation(fields: [id_pembelian], references: [id_pembelian], map: "BatchProduk_id_pembelian_fkey")
  produk              produk           @relation(fields: [id_produk], references: [id_produk], map: "BatchProduk_id_produk_fkey")
  pembeliandetail     pembeliandetail? @relation(fields: [id_pembelian_detail], references: [id_pembelian_detail])
  transaksibatch      transaksibatch[]

  @@index([id_pembelian], map: "BatchProduk_id_pembelian_fkey")
  @@index([id_produk], map: "BatchProduk_id_produk_fkey")
  @@index([id_pembelian_detail], map: "batchproduk_id_pembelian_detail_fkey")
}

model kategori {
  id_kategori   Int      @id @default(autoincrement())
  nama_kategori String   @unique(map: "Kategori_nama_kategori_key")
  created_at    DateTime @default(now())
  is_active     Boolean  @default(true)
  produk        produk[]
}

model logstok {
  id_log     Int          @id @default(autoincrement())
  id_produk  Int
  tipe       logstok_tipe
  qty        Int
  sumber     String
  created_at DateTime     @default(now())
  produk     produk       @relation(fields: [id_produk], references: [id_produk], map: "LogStok_id_produk_fkey")

  @@index([id_produk], map: "LogStok_id_produk_fkey")
}

model pembelian {
  id_pembelian        Int               @id @default(autoincrement())
  no_faktur           String            @unique(map: "Pembelian_no_faktur_key")
  tanggal_faktur      DateTime
  tanggal_jatuh_tempo DateTime?
  status              pembelian_status
  total               Decimal           @db.Decimal(15, 2)
  id_supplier         Int
  id_user             Int
  created_at          DateTime          @default(now())
  subtotal            Decimal           @default(0.00) @db.Decimal(15, 2)
  nilai_ppn           Int               @default(11)
  jenis_ppn           String            @default("tambah_ppn") @db.VarChar(20)
  cashback            Decimal           @default(0.00) @db.Decimal(15, 2)
  jenis_pembayaran    String            @default("Tunai") @db.VarChar(20)
  akun_kas            String?           @db.VarChar(50)
  no_surat_pesanan    String?           @db.VarChar(100)
  catatan             String?           @db.Text
  batchproduk         batchproduk[]
  supplier            supplier          @relation(fields: [id_supplier], references: [id_supplier], map: "Pembelian_id_supplier_fkey")
  user                user              @relation(fields: [id_user], references: [id_user], map: "Pembelian_id_user_fkey")
  pembeliandetail     pembeliandetail[]

  @@index([id_supplier], map: "Pembelian_id_supplier_fkey")
  @@index([id_user], map: "Pembelian_id_user_fkey")
}

model pembeliandetail {
  id_pembelian_detail Int           @id @default(autoincrement())
  id_pembelian        Int
  id_produk           Int
  qty                 Int
  harga_beli          Decimal       @db.Decimal(15, 2)
  diskon              Decimal       @default(0.00) @db.Decimal(15, 2)
  diskon_tipe         String        @default("%") @db.VarChar(5)
  subtotal            Decimal       @default(0.00) @db.Decimal(15, 2)
  batchproduk         batchproduk[]
  pembelian           pembelian     @relation(fields: [id_pembelian], references: [id_pembelian], map: "PembelianDetail_id_pembelian_fkey")
  produk              produk        @relation(fields: [id_produk], references: [id_produk], map: "PembelianDetail_id_produk_fkey")

  @@index([id_pembelian], map: "PembelianDetail_id_pembelian_fkey")
  @@index([id_produk], map: "PembelianDetail_id_produk_fkey")
}

model produk {
  id_produk       Int               @id @default(autoincrement())
  nama_produk     String
  barcode         String?
  id_kategori     Int
  stok_minimum    Int
  harga_jual      Decimal
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  updated_at      DateTime
  satuan_id       Int
  batchproduk     batchproduk[]
  hold_item       hold_item[]
  logstok         logstok[]
  pembeliandetail pembeliandetail[]
  kategori        kategori          @relation(fields: [id_kategori], references: [id_kategori], map: "Produk_id_kategori_fkey")
  satuan          satuan            @relation(fields: [satuan_id], references: [id], map: "fk_produk_satuan")
  transaksidetail transaksidetail[]

  @@unique([barcode, satuan_id], map: "barcode")
  @@unique([barcode, satuan_id], map: "unique_barcode_satuan")
  @@index([id_kategori], map: "Produk_id_kategori_fkey")
  @@index([satuan_id], map: "fk_produk_satuan")
}

model satuan {
  id     Int      @id @default(autoincrement())
  kode   String   @unique(map: "kode") @db.VarChar(20)
  nama   String   @db.VarChar(100)
  produk produk[]
}

model supplier {
  id_supplier   Int         @id @default(autoincrement())
  nama_supplier String
  email         String?
  telepon       String?
  alamat        String?     @db.Text
  created_at    DateTime    @default(now())
  pembelian     pembelian[]
}

model transaksi {
  id_transaksi      Int                    @id @default(autoincrement())
  no_transaksi      String                 @unique(map: "Transaksi_no_transaksi_key")
  tanggal_transaksi DateTime               @default(now())
  metode_bayar      transaksi_metode_bayar
  total             Decimal                @db.Decimal(15, 2)
  id_user           Int
  id_shift          Int?
  status            transaksi_status       @default(SELESAI)
  pembayaran        pembayaran[]
  shift             shift?                 @relation(fields: [id_shift], references: [id_shift], onDelete: NoAction, onUpdate: NoAction, map: "Transaksi_id_shift_fkey")
  user              user                   @relation(fields: [id_user], references: [id_user], map: "Transaksi_id_user_fkey")
  transaksidetail   transaksidetail[]

  @@index([id_user], map: "Transaksi_id_user_fkey")
  @@index([id_shift], map: "Transaksi_id_shift_fkey")
}

model transaksibatch {
  id_transaksi_batch  Int             @id @default(autoincrement())
  id_transaksi_detail Int
  id_batch            Int
  qty_keluar          Int
  batchproduk         batchproduk     @relation(fields: [id_batch], references: [id_batch], map: "TransaksiBatch_id_batch_fkey")
  transaksidetail     transaksidetail @relation(fields: [id_transaksi_detail], references: [id_transaksi_detail], map: "TransaksiBatch_id_transaksi_detail_fkey")

  @@index([id_batch], map: "TransaksiBatch_id_batch_fkey")
  @@index([id_transaksi_detail], map: "TransaksiBatch_id_transaksi_detail_fkey")
}

model transaksidetail {
  id_transaksi_detail Int              @id @default(autoincrement())
  id_transaksi        Int
  id_produk           Int
  qty                 Int
  harga_jual          Decimal          @db.Decimal(15, 2)
  subtotal            Decimal          @db.Decimal(15, 2)
  transaksibatch      transaksibatch[]
  produk              produk           @relation(fields: [id_produk], references: [id_produk], map: "TransaksiDetail_id_produk_fkey")
  transaksi           transaksi        @relation(fields: [id_transaksi], references: [id_transaksi], map: "TransaksiDetail_id_transaksi_fkey")

  @@index([id_produk], map: "TransaksiDetail_id_produk_fkey")
  @@index([id_transaksi], map: "TransaksiDetail_id_transaksi_fkey")
}

model user {
  id_user          Int                @id @default(autoincrement())
  nama             String
  password_hash    String
  role             user_role
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  email            String             @unique(map: "User_email_key")
  username         String             @unique(map: "User_username_key")
  audit_log        audit_log[]
  hold             hold[]
  kas_kecil        kas_kecil[]
  pembelian        pembelian[]
  shift            shift[]
  transaksi        transaksi[]
  verificationcode verificationcode[]
}

model verificationcode {
  id_code    Int      @id @default(autoincrement())
  email      String
  code       String
  expires_at DateTime
  created_at DateTime @default(now())
  id_user    Int
  user       user     @relation(fields: [id_user], references: [id_user], map: "VerificationCode_id_user_fkey")

  @@index([id_user], map: "VerificationCode_id_user_fkey")
}

model audit_log {
  id_audit   Int      @id @default(autoincrement())
  id_user    Int?
  aksi       String   @db.VarChar(100)
  tabel      String?  @db.VarChar(100)
  id_data    Int?
  detail     String?  @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  user       user?    @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "AuditLog_id_user_fkey")

  @@index([id_user], map: "AuditLog_id_user_fkey")
}

model hold {
  id_hold        Int         @id @default(autoincrement())
  nama_pelanggan String      @db.VarChar(255)
  alasan         String?     @db.Text
  waktu          DateTime    @default(now()) @db.DateTime(0)
  id_user        Int
  created_at     DateTime    @default(now()) @db.DateTime(0)
  user           user        @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "Hold_id_user_fkey")
  hold_item      hold_item[]

  @@index([id_user], map: "Hold_id_user_fkey")
}

model hold_item {
  id_hold_item Int     @id @default(autoincrement())
  id_hold      Int
  id_produk    Int
  qty          Int
  harga_jual   Decimal @db.Decimal(15, 2)
  hold         hold    @relation(fields: [id_hold], references: [id_hold], onDelete: Cascade, onUpdate: NoAction, map: "HoldItem_id_hold_fkey")
  produk       produk  @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction, map: "HoldItem_id_produk_fkey")

  @@index([id_hold], map: "HoldItem_id_hold_fkey")
  @@index([id_produk], map: "HoldItem_id_produk_fkey")
}

model kas_kecil {
  id              Int            @id @default(autoincrement())
  id_shift        Int
  id_user         Int
  tipe            kas_kecil_tipe
  nominal         Decimal        @db.Decimal(15, 2)
  keterangan      String?        @db.Text
  waktu_transaksi DateTime       @default(now()) @db.DateTime(0)
  created_at      DateTime       @default(now()) @db.DateTime(0)
  shift           shift          @relation(fields: [id_shift], references: [id_shift], onDelete: NoAction, onUpdate: NoAction, map: "KasKecil_id_shift_fkey")
  user            user           @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "KasKecil_id_user_fkey")

  @@index([id_shift], map: "KasKecil_id_shift_fkey")
  @@index([id_user], map: "KasKecil_id_user_fkey")
}

model pembayaran {
  id_pembayaran Int                     @id @default(autoincrement())
  id_transaksi  Int
  metode_bayar  pembayaran_metode_bayar
  nominal       Decimal                 @db.Decimal(15, 2)
  created_at    DateTime                @default(now()) @db.DateTime(0)
  transaksi     transaksi               @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade, onUpdate: NoAction, map: "Pembayaran_id_transaksi_fkey")

  @@index([id_transaksi], map: "Pembayaran_id_transaksi_fkey")
}

model shift {
  id_shift        Int          @id @default(autoincrement())
  id_user         Int
  waktu_buka      DateTime     @default(now()) @db.DateTime(0)
  waktu_tutup     DateTime?    @db.DateTime(0)
  modal_awal      Decimal      @db.Decimal(15, 2)
  modal_akhir     Decimal?     @db.Decimal(15, 2)
  total_omzet     Decimal      @default(0.00) @db.Decimal(15, 2)
  total_tunai     Decimal      @default(0.00) @db.Decimal(15, 2)
  total_kas_kecil Decimal      @default(0.00) @db.Decimal(15, 2)
  status          shift_status @default(OPEN)
  created_at      DateTime     @default(now()) @db.DateTime(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.DateTime(0)
  kas_kecil       kas_kecil[]
  user            user         @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "Shift_id_user_fkey")
  transaksi       transaksi[]

  @@index([id_user], map: "Shift_id_user_fkey")
}

enum logstok_tipe {
  MASUK
  KELUAR
  KOREKSI
}

enum transaksi_metode_bayar {
  TUNAI
  QRIS
  TRANSFER
}

enum user_role {
  ADMIN
  STAFF
  KASIR
}

enum pembelian_status {
  LUNAS
  BELUM_DIBAYAR
  DIKEMBALIKAN
}

enum pembayaran_metode_bayar {
  TUNAI
  QRIS
  TRANSFER
}

enum kas_kecil_tipe {
  masuk
  keluar
}

enum shift_status {
  OPEN
  CLOSED
}

enum transaksi_status {
  DRAFT
  SELESAI
  DIBATALKAN
}
